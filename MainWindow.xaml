<Window x:Class="FotoCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:FotoCleaner.Infrastructure"
        Title="FotoCleaner v2.4 - Sesion de escaneo" Width="1180" Height="760" MinWidth="900" MinHeight="620"
        Background="#070D1D" FontFamily="Segoe UI" Foreground="#E5EDF8">
    <Window.Resources>
        <infra:ImagePreviewConverter x:Key="ImagePreviewConverter"/>
        <SolidColorBrush x:Key="Panel" Color="#0D1528"/>
        <SolidColorBrush x:Key="PanelLight" Color="#16233A"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8EA0BA"/>
        <SolidColorBrush x:Key="Blue" Color="#3B82F6"/>
        <SolidColorBrush x:Key="Green" Color="#10B981"/>
        <SolidColorBrush x:Key="Pink" Color="#F43F5E"/>
        <Style TargetType="Button"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="12,8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/></Style>
        <Style TargetType="ComboBox"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#E5EDF8"/><Setter Property="Background" Value="#17243A"/><Setter Property="BorderBrush" Value="#33445F"/><Setter Property="Padding" Value="10,7"/></Style>
        <Style TargetType="ListBoxItem"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#E5EDF8"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="86"/><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#050A17" BorderBrush="#1B2941" BorderThickness="0,0,0,1" Padding="16,0">
            <DockPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"><Ellipse Width="14" Height="14" Fill="#33445F" Margin="0,0,10,0"/><Ellipse Width="14" Height="14" Fill="#33445F" Margin="0,0,10,0"/><Ellipse Width="14" Height="14" Fill="#33445F" Margin="0,0,18,0"/><TextBlock Text="FotoCleaner v2.4" FontWeight="SemiBold" Foreground="#DCE7F7"/><TextBlock Text="  |  Sesion de escaneo: " Foreground="{StaticResource TextMuted}"/><TextBlock Text="{Binding SelectedFolder}" TextTrimming="CharacterEllipsis" Foreground="#D7E4F7" Width="360"/></StackPanel>
                <Border DockPanel.Dock="Right" Background="#06352F" BorderBrush="#087C65" BorderThickness="1" CornerRadius="5" Padding="11,6"><TextBlock Text="&#10003;  Cache activa" Foreground="#34D399" FontSize="11" FontWeight="Bold"/></Border>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Background="#0B1426" BorderBrush="#1B2941" BorderThickness="0,0,0,1" Padding="24,0">
            <DockPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Grupo actual" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" DisplayMemberPath="Label" Width="360"/></StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center"><TextBlock Text="Fotos analizadas: " Foreground="{StaticResource TextMuted}"/><TextBlock Text="{Binding DuplicateCount}" Foreground="#DCE7F7" FontWeight="Bold"/><TextBlock Text="   |   Umbral: " Foreground="{StaticResource TextMuted}"/><TextBlock Text="{Binding Threshold, StringFormat={}{0:0}%}" Foreground="#60A5FA" FontWeight="Bold"/><Button Content="Explorar" Command="{Binding SelectFolderCommand}" Background="#17243A" Foreground="#C9D7EA" Margin="18,0,8,0" Padding="10,6"/><Button Content="Iniciar analisis" Command="{Binding ScanCommand}" IsEnabled="{Binding CanScan}" Background="{StaticResource Blue}" Foreground="White" Padding="12,7"/></StackPanel>
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Row="2" x:Name="ResultsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,28">
            <StackPanel>
                <TextBlock Text="Comparacion visual" FontSize="18" FontWeight="Bold" Foreground="#F3F7FD" Margin="0,0,0,4"/>
                <TextBlock Text="Revisa las fotos similares y marca las copias que quieres retirar." FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,20"/>
                <ItemsControl ItemsSource="{Binding SelectedGroup.Items}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Width="430" Margin="0,0,18,18" Padding="14" Background="{StaticResource Panel}" BorderBrush="#1D3B63" BorderThickness="1" CornerRadius="5">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="300"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#020817" CornerRadius="4" ClipToBounds="True"><Image Source="{Binding FullPath, Converter={StaticResource ImagePreviewConverter}}" Stretch="Uniform" RenderTransformOrigin="0.5,0.5"><Image.RenderTransform><RotateTransform Angle="{Binding Rotation}"/></Image.RenderTransform></Image></Border>
                                <Border Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Background="#064E3B" CornerRadius="3" Padding="7,4"><TextBlock Text="ORIGINAL" FontSize="10" FontWeight="Bold" Foreground="#A7F3D0"/></Border>
                                <StackPanel Grid.Row="1" Margin="0,12,0,0"><DockPanel><TextBlock Text="{Binding FileName}" FontWeight="SemiBold" Foreground="#E5EDF8" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Details}" Foreground="#60A5FA" DockPanel.Dock="Right" Margin="10,0,0,0"/></DockPanel><TextBlock Text="Ruta local de la foto" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,5,0,0"/></StackPanel>
                                <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsSelected}" Content="Conservar" Foreground="#B9C8DC" VerticalAlignment="Center"/><Button Grid.Column="1" Content="&#8635; Girar" Command="{Binding RotateCommand}" Background="#17243A" Foreground="#B9C8DC" Padding="9,5" Margin="6,0"/><Button Grid.Column="2" Content="Marcar copia" Command="{Binding SelectCommand}" Background="#3A1422" Foreground="#FDA4AF" Padding="9,5"/></Grid>
                            </Grid>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Selecciona una carpeta y ejecuta un análisis para comenzar." Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,30,0,0"/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="3" Background="#050A17" BorderBrush="#1B2941" BorderThickness="0,1,0,0" Padding="24,0">
            <DockPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="Accion automatica: " Foreground="{StaticResource TextMuted}" FontSize="12"/><TextBlock Text="Mover a la carpeta Duplicadas" Foreground="#60A5FA" FontWeight="Bold" FontSize="12"/><TextBlock Text="  (reversible)" Foreground="{StaticResource TextMuted}" FontSize="12"/></StackPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="Desmarcar todo" Command="{Binding ClearSelectionCommand}" Background="#17243A" Foreground="#B9C8DC" Margin="0,0,10,0"/><Button Content="Ejecutar limpieza" Command="{Binding MoveSelectedCommand}" Background="{StaticResource Pink}" Foreground="White" Padding="18,10"/></StackPanel></DockPanel>
        </Border>
    </Grid>
</Window>
