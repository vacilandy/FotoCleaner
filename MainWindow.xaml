<Window x:Class="FotoCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:FotoCleaner.Infrastructure"
        Title="FotoCleaner - Detector de duplicados" Width="1180" Height="760" MinWidth="900" MinHeight="620"
        Background="#F8FAFC" FontFamily="Segoe UI">
    <Window.Resources>
        <infra:ImagePreviewConverter x:Key="ImagePreviewConverter"/>
        <SolidColorBrush x:Key="Slate900" Color="#0F172A"/>
        <SolidColorBrush x:Key="Slate700" Color="#334155"/>
        <SolidColorBrush x:Key="Slate500" Color="#64748B"/>
        <SolidColorBrush x:Key="Slate200" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="Sky600" Color="#0284C7"/>
        <SolidColorBrush x:Key="Emerald600" Color="#059669"/>
        <SolidColorBrush x:Key="Rose600" Color="#E11D48"/>
        <DropShadowEffect x:Key="FolderShadow" BlurRadius="12" ShadowDepth="2" Opacity="0.12" Color="#0284C7"/>
        <Style TargetType="Button"><Setter Property="Padding" Value="16,9"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/></Style>
        <Style TargetType="ItemsControl">
            <Setter Property="ItemsPanel">
                <Setter.Value><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Border" x:Key="Card"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/></Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="28,16">
            <StackPanel Orientation="Horizontal">
                <Border Background="{StaticResource Sky600}" CornerRadius="7" Padding="10,7" Margin="0,0,12,0"><TextBlock Text="&#128444;" FontSize="20" Foreground="White"/></Border>
                <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="Detector de fotos duplicadas" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Slate900}"/><Border Background="#DBEAFE" CornerRadius="10" Padding="8,3" Margin="10,2,0,0"><TextBlock Text=".NET 8 + SQLite" FontSize="11" Foreground="#1D4ED8"/></Border></StackPanel><TextBlock Text="Limpieza inteligente por comparación visual" FontSize="12" Foreground="{StaticResource Slate500}" Margin="0,3,0,0"/></StackPanel>
            </StackPanel>
        </Border>
        <ScrollViewer x:Name="ResultsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="28,24">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,10,0"><StackPanel><TextBlock Text="ARCHIVOS ANALIZADOS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Slate500}"/><TextBlock Text="Listos para revisar" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Slate900}" Margin="0,8,0,0"/><TextBlock Text="Hash perceptual dHash" FontSize="11" Foreground="{StaticResource Slate500}"/></StackPanel></Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,10,0"><StackPanel><TextBlock Text="GRUPOS DUPLICADOS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Slate500}"/><TextBlock Text="{Binding DuplicateCount}" FontSize="20" FontWeight="Bold" Foreground="#D97706" Margin="0,8,0,0"/><TextBlock Text="Coincidencias encontradas" FontSize="11" Foreground="{StaticResource Slate500}"/></StackPanel></Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16" Margin="0,0,10,0"><StackPanel><TextBlock Text="MODO DE ANÁLISIS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Slate500}"/><TextBlock Text="Solo fotos" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Emerald600}" Margin="0,8,0,0"/><TextBlock Text="Todos los formatos de imagen" FontSize="11" Foreground="{StaticResource Slate500}"/></StackPanel></Border>
                    <Border Grid.Column="3" Style="{StaticResource Card}" Padding="16"><StackPanel><TextBlock Text="CACHÉ SQLITE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Slate500}"/><TextBlock Text="Activo" FontSize="20" FontWeight="Bold" Foreground="#4F46E5" Margin="0,8,0,0"/><TextBlock Text="Acelera nuevos escaneos" FontSize="11" Foreground="{StaticResource Slate500}"/></StackPanel></Border>
                </Grid>
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,16"><StackPanel><TextBlock Text="Configuración del análisis" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Slate900}"/><TextBlock Text="Selecciona una carpeta y ajusta la sensibilidad de comparación." FontSize="12" Foreground="{StaticResource Slate500}" Margin="0,3,0,0"/></StackPanel><Button Content="&#128193;  Explorar carpeta" Command="{Binding SelectFolderCommand}" Background="#F8FAFC" BorderBrush="#BAE6FD" BorderThickness="1" Foreground="{StaticResource Slate700}" Padding="12,7" Effect="{StaticResource FolderShadow}" DockPanel.Dock="Right"/></DockPanel>
                        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0"><TextBlock Text="CARPETA LOCAL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Slate500}"/><Border Background="#F8FAFC" BorderBrush="{StaticResource Slate200}" BorderThickness="1" CornerRadius="5" Padding="12,10" Margin="0,6,0,0"><TextBlock Text="{Binding SelectedFolder}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Slate700}" FontFamily="Consolas" FontSize="12"/></Border></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,24,0"><DockPanel><TextBlock Text="UMBRAL DE SIMILITUD" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Slate500}"/><TextBlock Text="{Binding Threshold, StringFormat={}{0:0}%}" Foreground="{StaticResource Sky600}" FontWeight="Bold" DockPanel.Dock="Right"/></DockPanel><Slider Minimum="80" Maximum="100" Value="{Binding Threshold}" TickFrequency="5" IsSnapToTickEnabled="True" Foreground="{StaticResource Sky600}" Margin="0,8,0,0"/><DockPanel Margin="0,3,0,0"><TextBlock Text="80% flexible" FontSize="10" Foreground="{StaticResource Slate500}"/><TextBlock Text="100% exacto" FontSize="10" Foreground="{StaticResource Slate500}" DockPanel.Dock="Right"/></DockPanel><DockPanel Margin="0,14,0,0"><TextBlock Text="TAMAÑO DE VISTA PREVIA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Slate500}"/><TextBlock Text="{Binding PreviewSize, StringFormat={}{0:0}px}" Foreground="{StaticResource Slate700}" FontWeight="Bold" DockPanel.Dock="Right"/></DockPanel><Slider Minimum="90" Maximum="220" Value="{Binding PreviewSize}" TickFrequency="10" IsSnapToTickEnabled="True" Foreground="{StaticResource Sky600}" Margin="0,8,0,0"/></StackPanel>
                            <Button Grid.Column="2" Content="&#9889;  Iniciar análisis de fotos" Command="{Binding ScanCommand}" IsEnabled="{Binding CanScan}" Background="{StaticResource Sky600}" Foreground="White" MinWidth="190" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Row="2" Margin="0,16,0,0"><TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Slate500}" FontSize="12"/><ProgressBar Height="5" Margin="0,7,0,0" IsIndeterminate="True" Visibility="Hidden" Foreground="{StaticResource Sky600}"/></StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#FFF7ED" CornerRadius="8" Padding="9" Margin="0,0,12,0"><TextBlock Text="Limpieza" FontSize="16" Foreground="#C2410C"/></Border><StackPanel><TextBlock Text="Acciones rápidas de limpieza" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Slate700}"/><TextBlock Text="Selecciona o desmarca fotos con un solo clic." FontSize="11" Foreground="{StaticResource Slate500}" Margin="0,4,0,0"/></StackPanel></StackPanel><WrapPanel Grid.Column="1" VerticalAlignment="Center"><Button Content="Seleccionar foto más pequeña" Command="{Binding SelectLowQualityCommand}" Background="#FFFBEB" Foreground="#92400E" Margin="0,0,8,0" Padding="12,8"/><Button Content="Desmarcar todo" Command="{Binding ClearSelectionCommand}" Background="#F1F5F9" Foreground="{StaticResource Slate700}" Margin="0,0,8,0" Padding="12,8"/><Button Content="Mover a Duplicadas" Command="{Binding MoveSelectedCommand}" Background="{StaticResource Rose600}" Foreground="White" Padding="12,8"/></WrapPanel></Grid></Border>
                <ListView Grid.Row="3" PreviewMouseWheel="ResultsList_PreviewMouseWheel" ItemsSource="{Binding Groups}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.CacheLength="1" VirtualizingPanel.CacheLengthUnit="Page"><ListView.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12"><StackPanel><TextBlock Text="{Binding Label}" FontWeight="Bold" Foreground="{StaticResource Slate700}" Margin="0,0,0,8"/><ItemsControl ItemsSource="{Binding Items}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#F8FAFC" Padding="10" Margin="0,3" CornerRadius="5"><DockPanel><CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="2,0,10,0"/><StackPanel Margin="0,0,14,0"><Border Width="{Binding DataContext.PreviewSize, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding DataContext.PreviewSize, RelativeSource={RelativeSource AncestorType=Window}}" Background="#E2E8F0" ClipToBounds="True"><Image Source="{Binding FullPath, Converter={StaticResource ImagePreviewConverter}}" Stretch="Uniform" RenderTransformOrigin="0.5,0.5"><Image.RenderTransform><RotateTransform Angle="{Binding Rotation}"/></Image.RenderTransform></Image></Border><Button Content="&#8635; Girar 90 grados" Command="{Binding RotateCommand}" Padding="7,4" FontSize="11" Background="#E0F2FE" Foreground="#0369A1" Margin="0,6,0,0" ToolTip="Girar previsualización"/></StackPanel><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding FileName}" FontWeight="SemiBold" Foreground="{StaticResource Slate700}" TextWrapping="Wrap"/><TextBlock Text="{Binding Details}" Foreground="{StaticResource Slate500}" FontSize="12" Margin="0,5,0,0"/></StackPanel></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></DataTemplate></ListView.ItemTemplate></ListView>
                <TextBlock Grid.Row="4" Text="Los archivos seleccionados se moverán a la carpeta Duplicadas junto a la carpeta analizada." Foreground="{StaticResource Slate500}" FontSize="11" Margin="0,12,0,0"/>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
